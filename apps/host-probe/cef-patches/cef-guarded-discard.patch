+cef_page_discard_result_t ChromeBrowserHostImpl::TryDiscardPage() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return CEF_PAGE_DISCARD_REJECTED;
+  }
+  auto* contents = GetWebContents();
+  if (is_destroying_browser_ || !browser_ || !contents ||
+      contents->IsBeingDestroyed() || contents->IsLoading() ||
+      contents->GetVisibility() == content::Visibility::VISIBLE) {
+    return CEF_PAGE_DISCARD_REJECTED;
+  }
+  using performance_manager::PerformanceManager;
+  if (!PerformanceManager::IsAvailable()) {
+    return CEF_PAGE_DISCARD_REJECTED;
+  }
+  auto node = PerformanceManager::GetPrimaryPageNodeForWebContents(contents);
+  auto* helper =
+      performance_manager::policies::PageDiscardingHelper::GetFromGraph(
+          PerformanceManager::GetGraph());
+  if (!node || !helper) {
+    return CEF_PAGE_DISCARD_REJECTED;
+  }
+  // Discard can synchronously destroy the old WebContents and retire this host.
+  CefRefPtr<ChromeBrowserHostImpl> keep_alive(this);
+  return helper->TryDiscardPageForNativeEmbedder(node.get())
+             ? CEF_PAGE_DISCARD_ACCEPTED
+             : CEF_PAGE_DISCARD_REJECTED;
+}
+
+cef_page_discard_state_t ChromeBrowserHostImpl::GetPageDiscardState() {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return CEF_PAGE_DISCARD_STATE_UNKNOWN;
+  }
+  auto* contents = GetWebContents();
+  if (is_destroying_browser_ || !browser_ || !contents ||
+      contents->IsBeingDestroyed()) {
+    return CEF_PAGE_DISCARD_STATE_UNKNOWN;
+  }
+  auto* lifecycle =
+      resource_coordinator::TabLifecycleUnitExternal::FromWebContents(contents);
+  if (!lifecycle) {
+    return CEF_PAGE_DISCARD_STATE_UNKNOWN;
+  }
+  switch (lifecycle->GetTabState()) {
+    case mojom::LifecycleUnitState::DISCARDED:
+      return CEF_PAGE_DISCARD_STATE_DISCARDED;
+    case mojom::LifecycleUnitState::ACTIVE:
+    case mojom::LifecycleUnitState::FROZEN:
+      return CEF_PAGE_DISCARD_STATE_NOT_DISCARDED;
+  }
+  return CEF_PAGE_DISCARD_STATE_UNKNOWN;
+}
