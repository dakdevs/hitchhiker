+bool PageDiscardingHelper::TryDiscardPageForNativeEmbedder(
+    const PageNode* node) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!node || node->GetGraph() != GetOwningGraph()) {
+    return false;
+  }
+  auto* policy = DiscardEligibilityPolicy::GetFromGraph(GetOwningGraph());
+  auto contents = node->GetWebContents();
+  if (!policy || !contents || contents->IsBeingDestroyed() ||
+      contents->IsLoading() ||
+      contents->GetVisibility() == content::Visibility::VISIBLE) {
+    return false;
+  }
+  constexpr auto reason = DiscardEligibilityPolicy::DiscardReason::PROACTIVE;
+  std::vector<CannotDiscardReason> protections;
+  const auto eligibility =
+      policy->CanDiscard(node, reason, base::Minutes(10), &protections);
+  const bool active_only =
+      eligibility == CanDiscardResult::kProtected && !protections.empty() &&
+      std::ranges::all_of(protections, [](CannotDiscardReason protection) {
+        return protection == CannotDiscardReason::kActiveTab;
+      });
+  if (eligibility != CanDiscardResult::kEligible && !active_only) {
+    return false;
+  }
+  DiscardEligibilityPolicy::AddDiscardAttemptMarker(
+      PageNodeImpl::FromNode(node));
+  // No task hop is allowed between eligibility and mutation. The PageNode and
+  // WebContents may be replaced synchronously; do not read them after this
+  // call.
+  return page_discarder_->DiscardPageNode(node, reason).has_value();
+}
