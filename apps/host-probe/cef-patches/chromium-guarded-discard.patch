+class NativeEmbedderDiscardTest : public PageDiscardingHelperTest {
+ public:
+  void SetUp() override {
+    PageDiscardingHelperTest::SetUp();
+    context_ = std::make_unique<content::TestBrowserContext>();
+    contents_ = content::WebContentsTester::CreateTestWebContents(
+        context_.get(), nullptr);
+    contents_->WasHidden();
+    native_page_ =
+        CreateNode<PageNodeImpl>(contents_->GetWeakPtr(), "", GURL(),
+                                 PagePropertyFlags(), base::TimeTicks::Now());
+    native_frame_ = CreateFrameNodeAutoId(process_node(), native_page_.get());
+    testing::MakePageNodeDiscardable(native_page_.get(), task_env());
+  }
+
+  void TearDown() override {
+    native_frame_.reset();
+    native_page_.reset();
+    contents_.reset();
+    context_.reset();
+    PageDiscardingHelperTest::TearDown();
+  }
+
+ protected:
+  bool TryDiscard() {
+    return PageDiscardingHelper::GetFromGraph(graph())
+        ->TryDiscardPageForNativeEmbedder(native_page_.get());
+  }
+  PageLiveStateDecorator::Data* LiveState() {
+    return PageLiveStateDecorator::Data::GetOrCreateForPageNode(
+        native_page_.get());
+  }
+  std::unique_ptr<content::TestBrowserContext> context_;
+  std::unique_ptr<content::WebContents> contents_;
+  TestNodeWrapper<PageNodeImpl> native_page_;
+  TestNodeWrapper<FrameNodeImpl> native_frame_;
+};
+
+TEST_F(NativeEmbedderDiscardTest, EligiblePageAndAttemptMarker) {
+  EXPECT_CALL(*discarder(), DiscardPageNodeImpl(native_page_.get()))
+      .WillOnce(Return(true));
+  EXPECT_TRUE(TryDiscard());
+  EXPECT_FALSE(TryDiscard());
+}
+
+TEST_F(NativeEmbedderDiscardTest, HiddenActiveTabOnly) {
+  LiveState()->SetIsActiveTabForTesting(true);
+  EXPECT_EQ(kProtected,
+            CanDiscard(native_page_.get(), DiscardReason::PROACTIVE));
+  EXPECT_CALL(*discarder(), DiscardPageNodeImpl(native_page_.get()))
+      .WillOnce(Return(true));
+  EXPECT_TRUE(TryDiscard());
+}
+
+TEST_F(NativeEmbedderDiscardTest, ActiveTabKeepsEveryOtherLiveProtection) {
+  LiveState()->SetIsActiveTabForTesting(true);
+  using Data = PageLiveStateDecorator::Data;
+  for (auto protect : {
+           &Data::SetIsCapturingAudioForTesting,
+           &Data::SetIsDiscardedForTesting,
+           &Data::SetIsCapturingVideoForTesting,
+           &Data::SetIsBeingMirroredForTesting,
+           &Data::SetIsCapturingWindowForTesting,
+           &Data::SetIsCapturingDisplayForTesting,
+           &Data::SetIsConnectedToUSBDeviceForTesting,
+           &Data::SetIsConnectedToBluetoothDeviceForTesting,
+           &Data::SetIsPinnedTabForTesting,
+           &Data::SetIsDevToolsOpenForTesting,
+           &Data::SetUpdatedTitleOrFaviconInBackgroundForTesting,
+       }) {
+    (LiveState()->*protect)(true);
+    EXPECT_FALSE(TryDiscard());
+    (LiveState()->*protect)(false);
+  }
+  LiveState()->SetIsAutoDiscardableForTesting(false);
+  EXPECT_FALSE(TryDiscard());
+  LiveState()->SetIsAutoDiscardableForTesting(true);
+  EXPECT_CALL(*discarder(), DiscardPageNodeImpl(native_page_.get()))
+      .WillOnce(Return(true));
+  EXPECT_TRUE(TryDiscard());
+}
+
+TEST_F(NativeEmbedderDiscardTest, VisibleOrRecentlyVisibleActiveTab) {
+  LiveState()->SetIsActiveTabForTesting(true);
+  contents_->WasShown();
+  EXPECT_FALSE(TryDiscard());
+  contents_->WasHidden();
+  native_page_->SetIsVisible(true);
+  EXPECT_FALSE(TryDiscard());
+  native_page_->SetIsVisible(false);
+  EXPECT_FALSE(TryDiscard());
+  task_env().FastForwardBy(base::Minutes(10));
+  EXPECT_CALL(*discarder(), DiscardPageNodeImpl(native_page_.get()))
+      .WillOnce(Return(true));
+  EXPECT_TRUE(TryDiscard());
+}
+
+TEST_F(NativeEmbedderDiscardTest, MissingContentsAndFailedMutation) {
+  EXPECT_FALSE(PageDiscardingHelper::GetFromGraph(graph())
+                   ->TryDiscardPageForNativeEmbedder(page_node()));
+  EXPECT_FALSE(PageDiscardingHelper::GetFromGraph(graph())
+                   ->TryDiscardPageForNativeEmbedder(nullptr));
+  EXPECT_CALL(*discarder(), DiscardPageNodeImpl(native_page_.get()))
+      .WillOnce(Return(false));
+  EXPECT_FALSE(TryDiscard());
+  EXPECT_FALSE(TryDiscard());
+}
