    "@hitchhiker/ui": "workspace:0.1.0",
    "effect": "4.0.0-beta.107",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "playwright-core": "1.63.0",
    "zod": "4.5.4"
  }
}
